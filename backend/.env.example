APP_NAME="BKX Labs"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=your-email@yourdomain.com
MAIL_PASSWORD=your-email-password
# MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_CONTACT_RECIPIENT=your-email@yourdomain.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Lemon Squeezy
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_SIGNING_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://bkxlabs.com/api/google/callback

# ──────────────────────────────────────────────────────────────
# Gemini AI (Google AI Studio)
# Get your key: https://aistudio.google.com/app/apikey
# ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ──────────────────────────────────────────────────────────────
# Social Media Publishing
# ──────────────────────────────────────────────────────────────

# Facebook Page (Graph API)
# 1. Create a Facebook App at https://developers.facebook.com
# 2. Add "Pages" product and generate a Page Access Token
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Instagram Business (via Facebook Graph API)
# Requires a Business/Creator account linked to a Facebook Page
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# LinkedIn Organization (Marketing API)
# 1. Create an app at https://www.linkedin.com/developers/apps
# 2. Get a long-lived OAuth token with w_member_social scope
# 3. Organization URN format: urn:li:organization:XXXXXXXX
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_URN=
